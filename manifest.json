{
  "name": "Studyria – Assam's #1 PDF Study Platform",
  "short_name": "Studyria",
  "description": "Free & premium PDF study materials for ADRE, APSC, Assam Police, Assam TET & all Assam state exams. Career Hub, job alerts & scholarships — all in one app.",
  "id": "/?source=pwa",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui",
    "browser"
