  "share_target": {
    "action": "/?share-target",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+studyria",
      "url": "/?protocol=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/?open-file",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      }
    }
  ],
  "url_handlers": [
    {
      "origin": "https://studyria.qzz.io"
