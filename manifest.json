  "orientation": "portrait-primary",
  "background_color": "#faf7f2",
  "theme_color": "#930205",
  "lang": "en-IN",
  "dir": "ltr",
  "prefer_related_applications": false,
  "categories": [
    "education",
    "books",
    "productivity"
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "handle_links": "preferred",
  "edge_side_panel": {
