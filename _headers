# ══════════════════════════════════════════════════════════════════
# Cloudflare Pages custom headers
# https://developers.cloudflare.com/pages/configuration/headers/
# Site is deployed via Cloudflare Pages git integration, so this file
# is picked up automatically on the next deploy — no other setup needed.
# ══════════════════════════════════════════════════════════════════

/*
  # ── Safe, zero-risk hardening (enforced) ──────────────────────────
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(self "https://checkout.razorpay.com")
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # ── Content-Security-Policy: REPORT-ONLY ──────────────────────────
  # Intentionally report-only, not enforced. This site relies heavily on
  # inline scripts/styles (Alpine.js, Tailwind CDN JIT) and several
  # third-party widgets (Razorpay checkout, OneSignal push, Supabase,
  # pdf.js). Flipping straight to an enforced policy risks silently
  # breaking payments, login, or notifications. Ship this report-only
  # first, watch the reports for a while, then tighten and enforce.
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://cdn.tailwindcss.com https://cdn.onesignal.com https://checkout.razorpay.com https://cdnjs.cloudflare.com https://js.sentry-cdn.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.tailwindcss.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://qsdfmgcekdpjdcyqhuhi.supabase.co wss://qsdfmgcekdpjdcyqhuhi.supabase.co https://onesignal.com https://api.onesignal.com https://cdn.onesignal.com https://*.pipedream.net https://api.razorpay.com; frame-src https://checkout.razorpay.com https://cdn.onesignal.com; manifest-src 'self'
